# RustFS credentials
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-me-in-env

# S3 endpoint (для кода, запускаемого на хосте)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cifar10

# Для доступа к RustFS из контейнеров docker-compose
RUSTFS_INTERNAL_ENDPOINT=http://rustfs:9000

# MLflow / PostgreSQL
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me-mlflow-db
MLFLOW_DB_NAME=mlflow
MLFLOW_BUCKET=mlflow